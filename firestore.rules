rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && request.auth.uid == businessId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Tenant / Business root match
    match /businesses/{businessId} {
      allow get, list: if isBusinessOwner(businessId);
      allow create, update, delete: if isBusinessOwner(businessId);

      // 1. Products & Inventory
      match /products/{productId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(productId);
      }

      // 2. Sales Transactions
      match /sales/{saleId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(saleId);
      }

      // 3. Purchases & Expenses (Libro de Compras)
      match /expenses/{expenseId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(expenseId);
      }

      // 4. Fiados (Cuentas por Cobrar)
      match /fiados/{fiadoId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(fiadoId);
      }

      // 5. Clientes
      match /clients/{clientId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(clientId);
      }

      // 6. Cuentas por Pagar (Proveedores)
      match /cuentasPorPagar/{cuentaId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(cuentaId);
      }

      // 7. Gastos Operativos (Fijos y Eventuales)
      match /gastosOperativos/{gastoId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(gastoId);
      }

      // 8. Historial de Cierres de Caja
      match /cashShiftHistory/{shiftId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(shiftId);
      }

      // 9. Store Metadata (Perfil, Tasas BCV, Turno Activo)
      match /metadata/{docId} {
        allow get, list: if isBusinessOwner(businessId);
        allow create, update, delete: if isBusinessOwner(businessId) && isValidId(docId);
      }
    }
  }
}
